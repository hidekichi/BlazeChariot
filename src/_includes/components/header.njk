
<meta charset="UTF-8">
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">

	<title>{% if title %}{{ title }}{% else %}BlazeChariot{% endif %}</title>
	<meta name="google-site-verification" content="xa6weg4F-oSHqFFa2cO3OXTDQwNXkD4r7_UVEdWW2F4" />
	<meta name="msvalidate.01" content="7321A9FC815E38B388EF7112CEBCA1B0" />

	<meta name="description" content="{% if description %}{{ description }}{% else %}BlazeChariotはギター初心者のためとブログのサイトです。11tyと言うので作りました。{% endif %}">
	<link rel="alternate" type="application/atom+xml" title="{{ site.title }} Atom Feed" href="/feed.xml" />
	<!-- Favicons -->
	<!-- Apple Touch Icon (reuse 192px icon.png) & standard favicons -->
	<link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/assets/images/favicons/apple-touch-icon.png" >
	<link rel="icon" type="image/png" sizes="32x32" href="/assets/images/favicons/favicon-32x32.png" >
	<link rel="icon" type="image/png" sizes="16x16" href="/assets/images/favicons/favicon-16x16.png" >
	<link rel="icon" type="image/x-icon" href="/assets/images/favicons/favicon.ico" >

	<!-- Open Graph -->
	<meta property="og:url" content="{{ site.name }}}{{ page.url }}">
	<meta property="og:type" content="website">
	<meta property="og:title" content="{% if title %}{{ title }}{% else %}BlazeChariot{% endif %}">
	<meta property="og:image" content="{% if cover %}{{ site.name }}{{ page.url | url }}{{ cover }}{% else %}/assets/images/opengraph-cover.jpg{% endif %}" />
	<meta property="og:description" content="{% if description %}{{ description }}{% else %}BlazeChariotはギター初心者のためにとブログのサイトです。11tyで作りました。{% endif %}" />
	<meta property="og:site_name" content="{{ site.title }}">
	<meta property="og:locale" content="ja_JP">

	<!-- Twitter -->
	<meta property="twitter:image" content="{% if cover %}{{ site.name }}{{ page.url | url }}{{ cover }}{% else %}{{ site.name }}}/assets/images/opengraph-cover.jpg{% endif %}" />
	<meta name="twitter:card" content="summary_large_image" />
