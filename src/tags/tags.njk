---
title: 関連タグ一覧
layout: page.njk
pagination:
  data: collections
  size: 1
  alias: tag
filter:
    - guitar
    - blog
permalink: /tags/{{ tag }}/
---

<h2>“{{ tag }}”の記事一覧</h2>

<ul>
{% set taglist = collections[ tag ] %}
{% for post in taglist | reverse %}
  <li><a href="{{ post.url }}">{{ post.data.title }}</a></li>
{% endfor %}
</ul>