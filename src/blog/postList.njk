---
layout: page.njk
title: 記事一覧 - General Articles
description: 一般的な記事一覧です。一般的ではないものもあるかも知れません。
category: blog

pagination:
  data: collections.blog
  size: 10
  alias: blog
permalink: /blog{% if pagination.pageNumber > 0 %}/page{{ pagination.pageNumber + 1}}{% endif %}/

sitemap:
  ignore: true
---

<section>
<h3>Now Entering Page {{ pagination.pageNumber + 1 }}</h3>

<div class="blog-wrapper">
  <div class="lastmod-10">
  <h4 class="my-[0]!">最新更新記事10件</h4>
  <ul class="listing listR">
    {% for entryR in collections.postsSortedByUpdate | limit(10) %}
      {% set itemUrl = entryR.url %}
      {% set itemTitle = entryR.data.title %}
      {% set postOrigin = entryR.data.date %}
      {% set originalPost = entryR.data.date | readableDate %}
      {% set lastmod = entryR.data.update %}
      {% set upDateStr = lastmod | readableDate %}

      <li>
        <div class="lastmod-meta text-sm">
          <time datetime="{{ lastmod }}">更新日：{{ upDateStr }}</time>
          <time class="originalPost text-teal-600" datetime="{{ postOrigin }}">投稿日：{{ originalPost }}</time>
        </div>
        <a href="{{ itemUrl }}">
          <span class="text-md">{{ itemTitle }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>
<ul class="listing left">
  {% for entry in blog %}

	{% set pub     = entry.date | dateToRfc3339 %}
	{% set upd     = entry.data.update | dateToRfc3339 %}
	{% set pubStr  = pub | readableDate %}
	{% set updStr  = upd | readableDate %}
	{% set pubYear = pubStr | replace(r/年.*/, "") %}
	{% set updYear = updStr | replace(r/年.*/, "") %}
	{% set image   = entry.data.images[0] %}

		<li>
			<a href="{{ entry.url }}">
  			<span class="post_update">
          <span class="isUpdate" title="2週間以内の更新があります" alt="I've updated it since the first post">★</span>
  			{% if upd and upd > pub %}
       	  {% if pubYear == updYear %}
            <!-- 同年 → 年を省略して「2026年2月1日★2月15日」 -->
            <time datetime="{{ pub }}">{{ pubStr }}</time><span class="separator">→</span>
            <time datetime="{{ upd }}">{{ updStr | replace(r/^[0-9]{4}年/, "") }}</time>
          {% else %}

            <!-- 異なる年 → 両方年付き -->
            <time datetime="{{ pub }}">{{ pubStr }}</time><span class="separator">→</span>
            <time datetime="{{ upd }}">{{ updStr }}</time>
          {% endif %}

        {% else %}
        <time datetime="{{ pub }}">{{ pubStr }}</time>
  			{% endif %}
  			</span>
			<div class="title-meta">
				<span class="title">{{ symbol }} {{ entry.data.title }}</span>

				{% if image %}
				  <div>
						<img src="{{ image | blogImage }}" alt="first image in article"/>
					</div>
				{% endif %}
			</div>
			<div class="summary">
				{{ entry.data.description or entry.templateContent | striptags | truncate(100) }}
			</div>
			</a>
		</li>
	{% endfor %}
</ul>

</div>
</section>

<nav id="articleList-pagination" aria-labelledby="pagination">
  <ol class="pagination">
    <li>{% if pagination.href.previous %}<a href="{{ pagination.href.previous }}"><button class="previous">Prev</button></a>{% else %}<button class="previous text-gray-800 bg-gray-600 aria-disabled cursor-not-allowed">Prev</button>{% endif %}</li>
	<li>{% if pagination.href.next %}<a href="{{ pagination.href.next }}"><button class="next">Next</button></a>{% else %}<button class="next text-gray-800 bg-gray-600 aria-disabled cursor-not-allowed">Next</button>{% endif %}</li>
{%- for pageEntry in pagination.pages %}
    <li><a href="{{ pagination.hrefs[ loop.index0 ] }}"{% if page.url == pagination.hrefs[ loop.index0 ] %} aria-current="page"{% endif %}>Page {{ loop.index }}</a></li>
{%- endfor %}
  </ol>
</nav>