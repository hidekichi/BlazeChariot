---
layout: base.njk
---

<header class="page-title">
	<h1 class="page-title__title mx-auto md:w-5/6">{{ title }}</h1>
	{% if description %}
		<h2 class="page-title__desc w-full md:w-2/3">{{ description }}</h2>
	{% endif %}

	<div class="header-meta">
  	<div>
  	  <span class="author">{{ site.author.name }}</span>{% if date %}｜<time class="page-title__date" datetime="{{ date }}">{{ date | readableDate }}</time> {% endif %}{% if update %} → <time class="page-title__update" datetime="{{ update }}">{{ update | readableDate }}</time>{% endif %}<br>
    </div>

    {% if tags and tags.length > 0 %}
		<div class="tags">
		{% for tag in tags -%}
			{% if tag !== 'posts' %}
				<a class="tag" href="/tags/{{ tag }}/" title="{{ tag }}">{{ tag }}</a>
			{% endif %}
		{%- endfor %}
		</div>
		{% endif %}

	</div>
</header>
<article class="body-copy {% if category %}cat-{{ category }}{% endif %}">
	{{ content | safe }}
</article>