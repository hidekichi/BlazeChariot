---json
{
  "permalink": "/feed.xml",
  "eleventyExcludeFromCollections": true,
  "metadata": {
    "title": "blazechariot",
    "language": "ja",
    "base": "https://blazechariot.netlify.app/",
    "author": {
      "name": "Hidekichi"
    }
  }
}
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ metadata.language or page.lang }}">

  <title>{{ metadata.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ permalink | htmlBaseUrl(metadata.base) }}" rel="self"/>
  <link href="{{ metadata.base | addPathPrefixToFullUrl }}/"/>
  <updated>{{ collections.latestPosts | getNewestCollectionItemDate | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ metadata.author.name }}</name>
  </author>
  {%- for post in collections.latestPosts -%}
  {%- set absolutePostUrl = site.url + post.url -%}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ absolutePostUrl }}"/>
    <updated>{{ (post.data.update or post.date) | dateToRfc3339 }}</updated>
    <summary>{{ post.templateContent | truncate(400) }}</summary>
    <id>{{ absolutePostUrl }}</id>
    <content type="html">
      <![CDATA[
        {{ post.templateContent  | renderTransforms(post.data.page, metadata.base) }}
      ]]>
    </content>
  </entry>
  {%- endfor -%}
  
</feed>