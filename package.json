{
	"name": "blazechariot",
	"version": "2.0.0",
	"type": "module",
	"description": "BlazeChariotはギター初心者のためとブログのサイトです。11tyと言うので作りました。",
	"scripts": {
		"clean": "del-cli dist",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"build:postcss": "postcss src/_assets/css/styles.css -o dist/assets/styles.min.css",
		"build:scripts": "esbuild src/_assets/scripts/scripts.js --bundle --minify --outfile=dist/assets/scripts.min.js --format=esm",
		"build:11ty": "cross-env ELEVENTY_ENV=production eleventy",
		"dev": "eleventy --serve --incremental",
		"build": "cross-env ELEVENTY_ENV=production run-s clean build:postcss build:scripts build:11ty"
	},
	"author": "HIDEKICHI",
	"license": "ISC",
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-fetch": "^4.0.0",
		"@11ty/eleventy-img": "^6.0.1",
		"@11ty/eleventy-navigation": "^1.0.4",
		"@11ty/eleventy-plugin-rss": "^2.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
		"@11ty/eleventy-plugin-vite": "^6.0.0-alpha.4",
		"@quasibit/eleventy-plugin-sitemap": "^2.2.0",
		"clean-css": "^5.3.3",
		"cross-env": "^7.0.3",
		"del-cli": "^5.1.0",
		"esbuild": "^0.25.0",
		"html-minifier-terser": "^7.2.0",
		"jsdom": "^26.1.0",
		"luxon": "^3.5.0",
		"markdown-it": "^14.1.0",
		"markdown-it-attrs": "^4.3.1",
		"markdown-it-figure": "^0.2.0",
		"markdown-it-multimd-table-ext": "^4.2.32",
		"markdown-it-ruby": "^1.1.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.5",
		"postcss-cli": "^11.0.1",
		"postcss-import": "^16.1.1",
		"postcss-preset-env": "^10.2.3",
		"sharp": "^0.33.5",
		"tailwindcss": "^4.1.0",
		"terser": "^5.34.1",
		"vite": "^6.3.5",
		"@tailwindcss/postcss": "^4.1.0"
	}
}
